    "Continue in background" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许后台继续下载"
          }
        }
      }
    },
    "Requires iOS 26 or later and system approval. If approval is unavailable, downloads run only in the foreground. The system may end background execution early." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要 iOS 26 及以上，并获得系统批准；未获批准时仅在前台运行。系统可能提前结束后台任务。"
          }
        }
      }
    },
    "Wait for background approval before leaving the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等到显示“已获准后台运行”后再切换 App。"
          }
        }
      }
    },
    "Downloads run in parallel and discard received data. They stop together at the total target, time limit, error or system cancellation. Background downloads require approval; otherwise leaving the app stops them." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多路下载接收后即丢弃数据，达到总目标、超时、发生错误或系统取消时一起停止。后台下载须先获准，否则切换 App 会停止任务。"
          }
        }
      }
    },
    "Recording continues during an approved background download. Otherwise it pauses until you return. Missed time is excluded from charge totals." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获准后台下载期间会继续采样和记录；其他情况下，进入后台后暂停，返回后继续。未采样的时间不计入充电总量。"
          }
        }
      }
    },
    "During an approved background download, MiniWatts keeps sampling and sending updates. Display timing is controlled by iOS. Otherwise readings pause; use Refresh on the activity to take a new one-time reading without opening the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获准后台下载期间会继续采样并发送更新，实际显示时机由 iOS 决定。其他情况下读数会暂停；点击实时活动上的刷新按钮，可不打开 App 进行一次新采样。"
          }
        }
      }
    },
    "Live power monitoring" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充电与网络实时监测"
          }
        }
      }
