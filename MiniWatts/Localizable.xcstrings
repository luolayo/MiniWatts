{
  "sourceLanguage" : "en",
  "strings" : {
    "Charging protocol" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充电协议"
          }
        }
      }
    },
    "Unidentified" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未识别"
          }
        }
      }
    },
    "Inferred from the selected power profile. PD version and PPS use cannot be determined." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据当前选中的充电档位推断。无法确定 PD 版本及是否使用 PPS。"
          }
        }
      }
    },
    "Wireless charging detected. Qi, Qi2 and MagSafe cannot be distinguished from this reading." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到无线充电。当前读数无法区分 Qi、Qi2 和 MagSafe。"
          }
        }
      }
    },
    "iOS did not report enough information to identify the charging protocol." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 上报的信息不足，无法识别充电协议。"
          }
        }
      }
    },
    "PD profiles are reported, but the active charging protocol is unidentified." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已上报 PD 档位，但当前使用的充电协议仍无法识别。"
          }
        }
      }
    },
    "Low resistance" : {
