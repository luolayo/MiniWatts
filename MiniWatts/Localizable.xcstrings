    "Start background monitoring" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后台实时监测"
          }
        }
      }
    },
    "No download is needed. Start monitoring here and wait for approval before switching apps. If iOS ends the session, the status and readings are marked stopped." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需运行流量消耗器。在这里开启并等到后台获准后即可切换 App；如果 iOS 结束任务，会明确显示停止状态。"
          }
        }
      }
    },
    "Start background live monitoring to keep power, temperature and network readings updating without a download. Approved download tasks can also support sampling. iOS controls display timing and may end background execution." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“后台实时监测”即可独立更新功率、温度和网速，无需下载流量。获准的下载任务也可支持采样。显示时机由 iOS 控制，系统可能结束后台任务。"
          }
        }
      }
    },
    "Enter a positive data amount in MB or GB." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入有效的正数流量，单位可选 MB 或 GB。"
          }
        }
      }
    },
    "Saved settings could not be read. Existing storage was not changed." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
