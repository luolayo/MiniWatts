    "No time limit" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不限时"
          }
        }
      }
    },
    "Downloads use the current connection. To use cellular data, turn off Wi-Fi in system settings. Carrier billing depends on your plan and download link." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载使用当前网络。使用蜂窝流量前请关闭 Wi-Fi，计费以运营商套餐和实际下载链接为准。"
          }
        }
      }
    },
    "Delete this saved configuration?" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除这份已保存配置？"
          }
        }
      }
    },
    "Resume remaining %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续剩余 %@"
