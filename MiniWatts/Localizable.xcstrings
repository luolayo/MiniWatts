            "value" : "连接充电器后开始测量。"
          }
        }
      }
    },
    "No power sensors found." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到功率传感器。"
          }
        }
      }
    },
    "Show Charging Activity" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
