      }
    },
    "Cable resistance is unavailable for wireless charging." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无线充电无法测量线缆电阻。"
          }
        }
      }
    },
    "Waiting for enough current to measure voltage drop." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待足够电流以测量压降。"
