        }
      }
    },
    "Wireless input power is unavailable; cell power is shown." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无线输入功率不可用，显示电芯功率。"
          }
        }
      }
    },
    "Plug in to start measuring." : {
      "localizations" : {
