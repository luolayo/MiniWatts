    "Enter a valid HTTPS download link without a username or password." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入有效的 HTTPS 下载直链，链接中不能包含用户名或密码。"
          }
        }
      },
