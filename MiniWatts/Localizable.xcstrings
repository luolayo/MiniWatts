            "value" : "当前修改尚未保存"
          }
        }
      }
    },
    "Save the link and all download settings here. Saved configurations and their latest saved progress are available after reopening the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存链接和下载参数后，下次打开可直接选择。已保存配置会记录最近的下载进度，可继续剩余目标。"
          }
        }
      }
    },
    "Target data" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
