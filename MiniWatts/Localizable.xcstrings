        }
      }
    },
    "Voltage drop detected. Try another cable." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到压降，请尝试更换线缆。"
          }
        }
      }
    },
    "No temperature sensors found." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未找到温度传感器。"
          }
        }
      }
    },
    "Charge history appears here after unplugging." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拔下充电器后，充电记录会显示在这里。"
          }
        }
      }
    },
    "Measured %@ of %@." : {
